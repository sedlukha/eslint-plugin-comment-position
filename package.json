{
  "name": "eslint-plugin-comment-position",
  "version": "0.4.4",
  "description": "ESLint plugin that enforces a consistent position for line and block comments (above or beside the code they describe), with autofix.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "comments",
    "comment-style",
    "lint",
    "code-style",
    "autofix",
    "formatting"
  ],
  "license": "MIT",
  "author": "sedlukha",
  "homepage": "https://github.com/sedlukha/eslint-plugin-comment-position#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sedlukha/eslint-plugin-comment-position.git"
  },
  "bugs": {
    "url": "https://github.com/sedlukha/eslint-plugin-comment-position/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.0",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^9.0.0",
    "tsdown": "0.20.3",
    "typescript": "^5.8.0",
    "vitest": "4.0.18"
  }
}
